VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (no VITE_ prefix — never reaches the browser bundle). Vimeo
# Personal Access Token with "Upload video" scope, from a Vimeo Pro app
# (developer.vimeo.com/apps). Used by api/vimeo-upload.ts to mint upload
# links for the rede social interna's vídeo posts (Fase C).
VIMEO_ACCESS_TOKEN=your-vimeo-personal-access-token
